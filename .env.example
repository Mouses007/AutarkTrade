# ── AutarkTrade — Docker-Konfiguration ──
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env

# Port auf dem Host (Standard: 8080)
AT_PORT=8080

# HTTPS-Port auf dem Host (Standard: 8443). Die App verwaltet ihr Zertifikat
# selbst (eigene CA, DOCKER.md › HTTPS); nichts zu erzeugen oder zu kopieren.
AT_TLS_PORT=8443

# Zusätzliche Namen/IPs fürs HTTPS-Zertifikat (Komma-Liste) — vor allem die
# Adresse des Hosts, die die App im Container nicht kennt.
AT_TLS_NAMEN=

# Absoluter Host-Pfad zum Projekt-Verzeichnis.
# Benoetigt fuer den App-Update-Button im Docker-Modus: der Helfer-Container
# mountet diesen Pfad und ruft "docker compose up -d" gegen das richtige
# Projekt auf. Beispiel: /home/user/trading-journal
AT_HOST_COMPOSE_DIR=

# ── Verschlüsselung ──
# Fester Schlüssel für API-Key-Verschlüsselung (gleich auf allen Instanzen setzen)
# Generieren mit: openssl rand -hex 32
AT_SECRET=

# ── Datenbank ──
# "postgresql" = externe PostgreSQL (z. B. NAS). Das ist auch die Vorgabe der
# docker-compose.yml, wenn DB_TYPE fehlt oder leer ist.
# "sqlite"     = SQLite im Container, Datei im Volume autarktrade_data (/app/data)
# Die Werte unten sind Platzhalter — eigene Adresse und Zugangsdaten eintragen.
DB_TYPE=postgresql
DB_HOST=192.0.2.10
DB_PORT=5432
DB_USER=autarktrade
DB_PASSWORD=dein_passwort_hier
DB_NAME=autarktrade
