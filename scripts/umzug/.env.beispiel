# Umzug der alten App auf AutarkTrade V2 (U1) — Vorlage.
#   cp scripts/umzug/.env.beispiel scripts/umzug/.env   (die .env ist NICHT im Git)
# Hier stehen keine Passwörter: DB-Zugang und Secret bleiben in der .env des
# NAS-Projekts und werden von den Skripten nie gelesen oder kopiert.

# NAS per SSH. „lokal" = alles auf diesem Rechner (Probelauf mit Wegwerf-Containern).
NAS_HOST=192.168.178.100
NAS_USER=MARO
# Ordner des Container-Manager-Projekts (enthält docker-compose.yml und .env)
NAS_PROJEKT=/volume1/docker/tradingjournal
# DSM legt docker nicht in den PATH einer SSH-Sitzung
NAS_DOCKER=/usr/local/bin/docker
NAS_SUDO=sudo
NAS_TMP=/tmp

# Compose-Projekt und Dienstname der App (Container heisst tradingjournal-trading-journal-1)
COMPOSE_PROJEKT=tradingjournal
APP_DIENST=trading-journal
APP_PORT=8080
TLS_PORT=8443

# Postgres-Container der Live-DB (postgres:17, Port 5433 nach aussen)
DB_CONTAINER=tradejournal-db
DB_NAME=tradejournal
DB_USER=tradejournal
PG_IMAGE=postgres:17

# Privates Tag des V2-Images auf der NAS. NIE mouses007/… — das wäre öffentlich.
V2_TAG=autarktrade:produktiv

# Hier landen Sicherung, Prüfwerte und der Merkzettel zwischen den Schritten
SICHERUNG_LOKAL=$HOME/AutarkTrade-Sicherungen

# Optional: ESP32-Schlüssel für die Prüfung von /api/esp32/display (sonst übersprungen)
# ESP32_KEY=
