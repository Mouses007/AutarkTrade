#. metadata.json->name
msgid "AutarkTrade Positionen"
msgstr ""

#. metadata.json->description
msgid "Shows open positions from the AutarkTrade"
msgstr "Zeigt offene Positionen aus dem AutarkTrade"

#. settings-schema.json->info-header->description
msgid ""
"This desklet requires a running AutarkTrade.\n"
""
msgstr ""
"Dieses Desklet benötigt ein laufendes AutarkTrade.\n"
""

#. settings-schema.json->server-host->description
msgid "Server host"
msgstr "Server-Host"

#. settings-schema.json->server-host->tooltip
msgid "IP or hostname, e.g. 192.168.178.100 or localhost"
msgstr "IP oder Hostname, z.B. 192.168.178.100 oder localhost"

#. settings-schema.json->server-port->description
msgid "Server port"
msgstr "Server-Port"

#. settings-schema.json->api-key->description
msgid "ESP32 API key"
msgstr "ESP32-API-Key"

#. settings-schema.json->api-key->tooltip
msgid ""
"From AutarkTrade → Settings → ESP32 Display → Generate key. Works even with the "
"password gate enabled."
msgstr ""
"Aus AutarkTrade → Einstellungen → ESP32 Display → Key generieren. Funktioniert "
"auch bei aktivem Passwortschutz."

#. settings-schema.json->refresh-interval->units
msgid "seconds"
msgstr "Sekunden"

#. settings-schema.json->refresh-interval->description
msgid "Refresh interval"
msgstr "Aktualisierungsintervall"

#. settings-schema.json->show-leverage->description
msgid "Show leverage"
msgstr "Hebel anzeigen"

#. settings-schema.json->show-mark-price->description
msgid "Show mark price"
msgstr "Mark-Preis anzeigen"

#. settings-schema.json->show-realized-pnl->description
msgid "Show realized PnL"
msgstr "Realisierten PnL anzeigen"

#. settings-schema.json->show-realized-pnl->tooltip
msgid ""
"Shows the already realized PnL of the open position (e.g. funding fees)"
msgstr ""
"Zeigt den bereits realisierten PnL der offenen Position (z.B. Funding-Fees)"

#. settings-schema.json->show-bots->description
msgid "Show Pionex bots"
msgstr "Pionex-Bots anzeigen"

#. settings-schema.json->show-bots->tooltip
msgid ""
"Shows running Pionex bots in a dedicated section (PnL/margin in the "
"respective coin, e.g. SOL for Coin-M)"
msgstr ""
"Zeigt laufende Pionex-Bots in einer eigenen Sektion (PnL/Marge in der "
"jeweiligen Münze, z.B. SOL bei Coin-M)"

#. settings-schema.json->show-github-link->description
msgid "Show app name in footer"
msgstr "App-Namen in der Fußzeile anzeigen"

