<?xml version="1.0" encoding="utf-8"?>
<!-- SEC-AND-001: nichts in Cloud-Backup oder Geräteübertragung — die Einstellungen
     enthalten Geräteschlüssel und den letzten Stand mit Saldo und Positionen. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
