<?xml version="1.0" encoding="utf-8"?>
<!-- Eingabefeld: panel-soft, Radius 10, Rahmen wird im Fokus zur Akzentfarbe. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_soft" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_soft" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
</selector>
